{
	"compilerOptions": {
		"target": "esnext",
		"useDefineForClassFields": false,
		"experimentalDecorators": true,
		/* Off on purpose: nothing reads design:type metadata, and emitting it makes
		   a decorated property reference its own type eagerly. Entity and World
		   import each other, so that reference runs while World is still
		   initialising and the module graph fails to evaluate. */
		"emitDecoratorMetadata": false,
		"module": "ESNext",
		"lib": [
			"ESNext",
			"DOM",
			"DOM.Iterable"
		],
		"skipLibCheck": true,
		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		/* Linting */
		"strict": true,
		// "noUnusedLocals": true,
		// "noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"paths": {
			"@/*": [
				"./src/*"
			]
		}
	},
	"include": [
		"src/**/*",
		"test/**/*"
	]
}